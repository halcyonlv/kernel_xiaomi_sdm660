# Crypto
CONFIG_MMC_CRYPTO=y

# DTB
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y

# exFAT
CONFIG_EXFAT_FS=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FPC_FINGERPRINT=y
CONFIG_GOODIX_FINGERPRINT=y

# HZ
# CONFIG_HZ_100 is not set
CONFIG_HZ_300=y

# initramfs
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y

# ION
CONFIG_ION_LEGACY=y

# Memory
CONFIG_OPLUS_MM_HACKS=y

# Modules
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_SHA512 is not set

# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Scheduler
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_BUCKETS_COUNT=5
CONFIG_UCLAMP_TASK_GROUP=y
# CONFIG_SCHED_TUNE is not set

# TCP IP
CONFIG_TCP_CONG_ADVANCED=y
# CONFIG_TCP_CONG_BIC is not set
# CONFIG_TCP_CONG_CUBIC is not set
# CONFIG_TCP_CONG_WESTWOOD is not set
# CONFIG_TCP_CONG_HTCP is not set
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y

# WLAN
CONFIG_QCA_CLD_WLAN=m

# ZRAM
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZRAM_DEFAULT_COMP_ALGORITHM="zstd"
